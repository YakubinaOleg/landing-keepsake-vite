mixin icon(name, size)
  - let px = size;
  if !px
    case name
      when 'monitor'
      when 'tv'
      when 'printer'
      when 'illustration'
        - px = 40;
      when 'burger'
      when 'close'
      when 'up'
      when 'check'
        - px = 20;
      when 'plus'
      when 'mail'
        - px = 16;
      default
        - px = 18;
  svg(width=px, height=px, aria-hidden='true')&attributes(attributes)
    use(href=`#i-${name}`)
