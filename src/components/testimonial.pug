figure.testimonial
  span.testimonial__mark(aria-hidden='true') “
  blockquote
    p #{ testimonial.text }
  figcaption.testimonial__author
    span.avatar(aria-hidden='true') #{ testimonial.initials }
    span.testimonial__who
      span.testimonial__name #{ testimonial.name }
      span.testimonial__role #{ testimonial.role }
    span.dots(aria-hidden='true')
      each dot, i in [0, 1, 2]
        span.dot(class={ 'is-active': i === 0 })
