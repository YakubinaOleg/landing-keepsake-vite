section#works.section.works(aria-labelledby='works-title')
  .container
    each category, i in categories
      input.works__radio.visually-hidden(
        type='radio',
        name='filter',
        value=category.id,
        id=`f-${category.id}`,
        checked=i === 0
      )
    input#more.works__toggle.visually-hidden(type='checkbox')

    .works__head
      h2#works-title.section-title.works__title Our awesome works
      .chips
        each category in categories
          label.chips__item(for=`f-${category.id}`) #{ category.label }

    .works__grid
      each work in works
        - const cat = categories.find((item) => item.id === work.category);
        +work-card(work, cat.label)

    .works__more
      label.btn.btn--secondary.works__more-btn(for='more') Load more works
